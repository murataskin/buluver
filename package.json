{
  "name": "izbul",
  "version": "1.0.0",
  "description": "TBB-İzBul Reborn: High-performance UDF search application with embedded FastMCP server",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "compile-main": "tsc -p tsconfig.node.json",
    "electron:dev": "npm run compile-main && electron .",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "fastmcp": "^4.3.2",
    "lucide-react": "^0.475.0",
    "node-stream-zip": "^1.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.tbb.izbul",
    "productName": "TBB-İzBul",
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    }
  }
}
